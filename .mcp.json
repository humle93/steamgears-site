{
  "mcpServers": {
    "steamgears": {
      "type": "http",
      "url": "https://steamgears.eu/wp-json/royal-mcp/v1/mcp",
      "headers": {
        "Authorization": "Basic ${ROYAL_MCP_AUTH}"
      }
    },
    "publer": {
      "type": "http",
      "url": "https://mcp.publer.com/",
      "headers": {
        "Authorization": "Bearer ${PUBLER_API_KEY}"
      }
    },
    "steamgears-profil": {
      "type": "stdio",
      "command": "python3",
      "args": ["tools/mcp_project_profile.py"]
    },
    "simplycom": {
      "type": "http",
      "url": "https://mcp.simply.com/v2"
    }
  }
}
