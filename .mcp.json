{
  "mcpServers": {
    "steamgears": {
      "type": "http",
      "url": "https://steamgears.eu/wp-json/mcp/v1/http",
      "headers": {
        "Authorization": "Bearer ${MCP_ACCESS_TOKEN}"
      }
    },
    "publer": {
      "type": "http",
      "url": "https://mcp.publer.com/",
      "headers": {
        "Authorization": "Bearer ${PUBLER_API_KEY}"
      }
    },
    "steamgears-profil": {
      "type": "stdio",
      "command": "python3",
      "args": ["tools/mcp_project_profile.py"]
    }
  }
}
