# Skabelon for lokalt miljø — kopiér til .env og udfyld værdierne der:
#
#   cp .env.example .env
#
# .env er gitignored (.gitignore linje 2-3) og må aldrig committes.
# Denne fil indeholder kun navne og pladsholdere og kan godt ligge i repoet.
#
# Til CI: de samme navne lægges som repo-secrets under
# Settings → Secrets and variables → Actions. GitHub kan ikke læse dem
# tilbage bagefter — de kan kun overskrives.

# Google AI Studio-nøgle. Læses af seo_agent.py:15 og seo_harvester.py:16.
# Kræves af .github/workflows/seo_audit.yml. Hentes på aistudio.google.com.
GEMINI_API_KEY=

# WordPress-bruger med administratorrettigheder. Læses af seo_agent.py:11.
WP_USER=

# WordPress application password (IKKE login-adgangskoden).
# Læses af seo_agent.py:12. Laves i wp-admin → Brugere → Profil →
# Application Passwords; det er 24 tegn med mellemrum.
# Alternativ: steamgears_auth.json med {"user": "...", "password": "..."}
# (gitignored, .gitignore linje 4).
WP_APP_PASS=

# Pinterest Standard-adgang. Læses af tools/niche_scanner.py:364.
# Uden den springes Pinterest-kilden over, og scanneren kører videre.
PINTEREST_ACCESS_TOKEN=

# Royal MCP mod steamgears.eu. Læses af .mcp.json (serveren `steamgears`) og wp_mcp_stdio.py.
# Værdien er den rå API-nøgle (32 hex) fra wp-admin → Royal MCP → Settings.
# IKKE base64 og IKKE et application password — MCP-ruten tager kun Bearer.
# Opskrift og målt auth-matrix: docs/mcp-auth.md.
ROYAL_MCP_API_KEY=

# Publer MCP-nøgle (Settings → AI & Automations → MCP, fanen No auth).
# Læses af .mcp.json (serveren `publer`) som `Authorization: Bearer <nøgle>`.
# Må ikke forveksles med REST-nøglen i sgap_publer_api_key (Bearer-API-skema).
# Opskrift: docs/mcp-auth.md. Kræver Publer Business/Enterprise.
PUBLER_API_KEY=
